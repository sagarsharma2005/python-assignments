import numpy as np

# 1 Replace NaN with 0 and Interchange Rows & Columns
# --------------------------------

print("----- Question 1 -----")

arr = np.array([
    [6, -8, 73],
    [-110, np.nan, -8],
    [0, 94, np.nan]
])

print("Original Array")
print(arr)

arr = np.nan_to_num(arr, nan=0)

print("\nAfter Replacing NaN with 0")
print(arr)

print("\nAfter Interchanging Rows and Columns")
print(arr.T)

# 2 Move Axes of 3D Array
# --------------------------------

print("\n----- Question 2 -----")

a = np.arange(24).reshape(2, 3, 4)

print("Original Shape :", a.shape)

b = np.moveaxis(a, 0, 2)

print("New Shape :", b.shape)

# 3 Replace NaN with Average of Columns
# --------------------------------

print("\n----- Question 3 -----")

arr2 = np.array([
    [10, np.nan, 30],
    [40, 50, np.nan],
    [70, 80, 90]
])

print("Original Array")
print(arr2)

col_mean = np.nanmean(arr2, axis=0)

index = np.where(np.isnan(arr2))

arr2[index] = np.take(col_mean, index[1])

print("\nAfter Replacing NaN with Column Average")
print(arr2)

# 4 Replace Negative Values with 0
# --------------------------------

print("\n----- Question 4 -----")

arr3 = np.array([10, -5, 20, -15, 30, -25])

print("Original Array")
print(arr3)

arr3 = np.where(arr3 < 0, 0, arr3)

print("\nAfter Replacing Negative Values with 0")
print(arr3)
